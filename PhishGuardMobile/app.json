{
  "expo": {
    "name": "SecureShield",
    "slug": "secureshield",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "image": "./assets/splash.png",
        "backgroundColor": "#0f172a"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.secureshield.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.secureshield.app",
      "userInterfaceStyle": "automatic"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0174b845-b02a-4fc3-ab54-76f1d61e6bd2"
      },
      "apiUrl": "https://mud-cable-passerby.ngrok-free.dev"
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      "expo-sharing",
      "expo-status-bar"
    ]
  }
}